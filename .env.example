# LAN-Adresse des Hosts, die im QR-Code landet. Leer lassen, um sie aus der Adresszeile des Screens abzuleiten.
# Beispiel: PUBLIC_URL=http://192.168.1.20:8080
PUBLIC_URL=

# KI-Modus (Spec 002): Adresse von Ollama und Modell. Nur relevant mit `docker compose --profile ki up`.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
